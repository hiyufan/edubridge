# JWT 密钥（32位以上，两者不可相同）
JWT_SECRET=change-me-to-a-random-string-of-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-32-chars

# MySQL 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=jww
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=jww

# Redis 缓存
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# 服务配置
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173
SECURE_COOKIE=false
